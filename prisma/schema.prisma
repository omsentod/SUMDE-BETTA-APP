datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String
  role          String    @default("customer")
  googleId      String?   @unique
  emailVerified DateTime?
  phone         String?
  streetAddress String?
  rtRw          String?
  province      String?
  city          String?
  district      String?
  village       String?
  postalCode    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  addresses     Address[]
  passwordResets     PasswordReset[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  permissions Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  link      String?
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Rumah")
  recipientName String
  phone         String
  streetAddress String
  rtRw          String
  province      String
  city          String
  district      String
  village       String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  category    String
  form        String
  coloration  String
  description String   @db.Text
  image       String
  images      Json?
  soldCount   Int      @default(0)
  isSold      Boolean  @default(false)
  isPremium   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  statsForm   String   @default("COMP")
  age         String   @default("4 Month")
  statsSpirit String   @default("Aktif")
  quantity    Int      @default(1)
  sizes       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  variants    ProductVariant[]
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size         String
  stock        Int      @default(0)
  price        Float?
  imageUrl     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]

  @@unique([productId, size])
  @@index([productId])
}

model Order {
  id                 String    @id @default(uuid())
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subtotal           Float     @default(0)
  shippingFee        Float     @default(0)
  paymentFee         Float     @default(0)
  paymentMethod      String?
  total              Float
  shippingCourier    String?
  shippingService    String?
  shippingEta        String?
  trackingNumber     String?
  biteshipShipmentId String?
  biteshipStatus     String?
  status             String    @default("PENDING")
  name               String
  email              String
  phone              String
  streetAddress      String
  rtRw               String
  province           String
  city               String
  district           String
  village            String
  postalCode         String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  items              OrderItem[]
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity     Int             @default(1)
  price        Float
  selectedSize String?

  @@index([variantId])
}

model PromoEvent {
  id          String    @id @default(uuid())
  title       String
  subtitle    String?
  description String    @db.Text
  image       String    @default("/img/betta-2.png")
  targetUrl   String
  buttonText  String    @default("Lihat Event")
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
