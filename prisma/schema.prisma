datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String
  role          String    @default("customer")
  googleId      String?   @unique
  avatarUrl     String?   @db.Text
  emailVerified DateTime?
  phone         String?
  phoneVerified DateTime?
  streetAddress String?
  rtRw          String?
  province      String?
  city          String?
  district      String?
  village       String?
  postalCode    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  addresses     Address[]
  passwordResets     PasswordReset[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  conversations      Conversation[]
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  color       String?  @default("#3B82F6")
  permissions Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  link      String?
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Rumah")
  recipientName String
  phone         String
  streetAddress String
  rtRw          String
  province      String
  city          String
  district      String
  village       String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  category    String
  form        String
  coloration  String
  description String   @db.Text
  image       String
  images      Json?
  soldCount   Int      @default(0)
  isSold      Boolean  @default(false)
  isPremium   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  statsForm   String   @default("COMP")
  age         String   @default("4 Month")
  statsSpirit String   @default("Aktif")
  quantity    Int      @default(1)
  sizes       Json?
  // Daily Drop Telegram & Flash Sale
  isDailyDrop        Boolean   @default(false)
  dropNumber         String?   // e.g. "#01", "#02"
  dropExpiresAt      DateTime? // Waktu berakhir drop 24 jam
  videoUrl           String?   // Link video ikan
  bookedBy           String?   // Telegram username pembeli yang sedang booking
  bookedTelegramId   String?   // Telegram user ID
  bookedUntil        DateTime? // Batas waktu bayar 15 menit
  telegramMessageId  Int?      // ID pesan di grup Telegram untuk auto-update status
  telegramChatId     String?   // Chat ID grup Telegram
  broadcastEventId   String?
  broadcastEvent     TelegramBroadcastEvent? @relation(fields: [broadcastEventId], references: [id], onDelete: SetNull)

  // Relasi Hierarki 3 Tingkat (Departemen -> Sub-Kategori -> Produk)
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subCategoryId      String?
  subCategory        SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  // Atribut Fisik Alat & Pakan
  brand              String?      // Merk produk (Sobo, Hikari, Atman, dsb)
  weight             Int          @default(1000) // Berat dalam gram untuk perhitungan Biteship

  // Fitur Partai (Wholesale / Grosir)
  isWholesale        Boolean      @default(false)
  wholesaleTiers     Json?        // Array of { minQty: Int, price: Float }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  variants    ProductVariant[]
  liveItems   TikTokLiveItem[]

  @@index([isDailyDrop, isSold])
  @@index([bookedUntil])
  @@index([broadcastEventId])
  @@index([departmentId])
  @@index([subCategoryId])
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size         String
  stock        Int      @default(0)
  price        Float?
  imageUrl     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]

  @@unique([productId, size])
  @@index([productId])
}

model Order {
  id                 String    @id @default(uuid())
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subtotal           Float     @default(0)
  shippingFee        Float     @default(0)
  paymentFee         Float     @default(0)
  paymentMethod      String?
  total              Float
  shippingCourier    String?
  shippingService    String?
  shippingEta        String?
  trackingNumber     String?
  biteshipShipmentId String?
  biteshipStatus     String?
  status             String    @default("PENDING")
  name               String
  email              String
  phone              String
  streetAddress      String
  rtRw               String
  province           String
  city               String
  district           String
  village            String
  postalCode         String
  telegramUsername   String?   // Username Telegram jika order dipesan via Telegram Drop
  orderSource        String    @default("WEB") // WEB | TELEGRAM | TIKTOK_LIVE
  tiktokUsername     String?   // Username pembeli TikTok Live
  tiktokAccountName  String?   // Nama/handle akun TikTok tempat live berlangsung
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  items              OrderItem[]
  tiktokLiveBasket   TikTokLiveBasket?

  @@index([orderSource])
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity     Int             @default(1)
  price        Float
  selectedSize String?
  customName   String?
  customImage  String?

  @@index([variantId])
}

model TikTokAccount {
  id         String             @id @default(uuid())
  name       String
  handle     String             @unique
  isActive   Boolean            @default(true)
  orderIndex Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  baskets    TikTokLiveBasket[]
  items      TikTokLiveItem[]

  @@index([orderIndex])
}

model TikTokLiveBasket {
  id              String           @id @default(uuid())
  claimCode       String           @unique
  claimToken      String?          @unique
  tiktokUsername  String
  tiktokAccountId String?
  tiktokAccount   TikTokAccount?   @relation(fields: [tiktokAccountId], references: [id], onDelete: SetNull)
  status          String           @default("OPEN") // OPEN | CHECKED_OUT | CANCELLED
  orderId         String?          @unique
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes           String?          @db.Text
  items           TikTokLiveItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tiktokUsername, status])
  @@index([status])
}

model TikTokLiveItem {
  id              String           @id @default(uuid())
  basketId        String
  basket          TikTokLiveBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  tiktokAccountId String?
  tiktokAccount   TikTokAccount?   @relation(fields: [tiktokAccountId], references: [id], onDelete: SetNull)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  selectedSize    String?
  name            String
  price           Float
  quantity        Int              @default(1)
  image           String?
  note            String?
  createdAt       DateTime         @default(now())

  @@index([basketId])
  @@index([productId])
}

model PromoEvent {
  id          String    @id @default(uuid())
  title       String
  subtitle    String?
  description String    @db.Text
  image       String    @default("/img/betta-2.png")
  targetUrl   String
  buttonText  String    @default("Lihat Event")
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TelegramBroadcastEvent {
  id              String    @id @default(uuid())
  title           String
  description     String?   @db.Text
  date            DateTime  @default(now())
  prefix          String    @default("R-")
  startNumber     Int       @default(1)
  padZero         Boolean   @default(true)
  durationHours   Int?
  isLifetime      Boolean   @default(false)
  expiresAt       DateTime?
  status          String    @default("DRAFT") // DRAFT | ACTIVE | COMPLETED
  headerMessageId Int?
  recapMessageId  Int?
  chatId          String?
  totalItems      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@index([status])
}

model Department {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?       @db.Text
  icon          String?       // vector icon identifier: fish | equipment | feed
  isLiveFish    Boolean       @default(true) // Live animals need form/gender/flaring/DOA; dry goods need brand/weight/warranty
  orderIndex    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  products      Product[]

  @@index([orderIndex])
}

model SubCategory {
  id           String      @id @default(uuid())
  name         String
  slug         String
  description  String?     @db.Text
  image        String?
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  orderIndex   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@index([orderIndex])
}

model RecycleBinItem {
  id         String   @id @default(uuid())
  entityType String   // PRODUCT | EVENT | DEPARTMENT | SUBCATEGORY | USER | ROLE | TELEGRAM_EVENT
  entityId   String
  name       String
  summary    String?  @db.Text
  data       Json
  deletedAt  DateTime @default(now())
  deletedBy  String?

  @@index([entityType])
  @@index([deletedAt])
}

model ChatTemplate {
  id           String   @id @default(uuid())
  chipLabel    String
  messageText  String   @db.Text
  answerText   String?  @db.Text
  isAutoReply  Boolean  @default(true)
  targetPos    String   @default("GLOBAL") // "PRODUCT" | "VIP_GALLERY" | "CHECKOUT" | "GLOBAL" | "ALL"
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([targetPos, isActive])
  @@index([sortOrder])
}

model Conversation {
  id                  String        @id @default(uuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestSessionId      String?       @unique
  guestName           String?
  guestEmail          String?
  status              String        @default("OPEN") // "OPEN" | "CLOSED"
  unreadAdminCount    Int           @default(0)
  unreadCustomerCount Int           @default(0)
  lastMessageAt       DateTime      @default(now())
  messages            ChatMessage[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([guestSessionId])
  @@index([lastMessageAt])
  @@index([status])
}

model ChatMessage {
  id              String        @id @default(uuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole      String        // "CUSTOMER", "ADMIN", "SYSTEM"
  senderId        String?       // userId jika terautentikasi, null jika guest
  message         String        @db.Text
  attachedType    String?       // "PRODUCT", "ORDER", null
  attachedId      String?       // ID Produk atau ID Order
  attachedMeta    String?       @db.Text // JSON string info snapshot (nama, gambar, harga/status)
  isRead          Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model ChatSetting {
  id                  String    @id @default("default")
  adminStatus         String    @default("AUTO") // "AUTO" | "ONLINE" | "AWAY" | "OFFLINE"
  operatingHoursStart String    @default("08:00")
  operatingHoursEnd   String    @default("21:00")
  offlineMessage      String    @db.Text
  emergencyWaNumber   String?
  adminLastActiveAt   DateTime?
  updatedAt           DateTime  @updatedAt
}


