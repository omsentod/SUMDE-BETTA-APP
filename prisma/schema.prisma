datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  // Nullable karena user yang daftar via Google OAuth tidak punya password
  // di sistem kita — mereka login lewat Google. User email/password punya
  // password ini terisi. Kalau salah satu ada = auth punya minimal 1 metode.
  password  String?
  name      String
  role      String   @default("customer") // "customer" | "admin"
  // Google Sub Claim (id user di Google). Unique — 1 akun Google = 1 user.
  // Null berarti user belum pernah link Google, cuma pakai password.
  googleId  String?  @unique
  // Null = belum verifikasi email. Timestamp = kapan berhasil verifikasi via OTP.
  // Login email/password diblokir sampai verifikasi (lihat AGENTS.md §Auth).
  // User via Google auto-set timestamp saat register (Google sudah verify email).
  emailVerified DateTime?
  phone         String?
  streetAddress String?
  rtRw          String?
  province      String?
  city          String?
  district      String?
  village       String?
  postalCode    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
  addresses     Address[]
  passwordResets PasswordReset[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
}

// Bell inbox — 1 row per event yang perlu dilihat user.
// Type contoh: 'order.new' (admin), 'order.paid', 'order.shipped', 'order.delivered'.
// readAt null = belum dibaca (badge merah aktif).
// link = deep link ke halaman relevan (misal /admin/orders?status=PENDING atau /customer/orders).
model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String    // 'order.new' | 'order.paid' | 'order.shipped' | ...
  title      String
  body       String    @db.Text
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// Simpan browser push subscription per user (bisa >1 kalau user pakai
// multiple browser / device). Endpoint unik per browser.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // FCM/Web Push endpoint biasanya 150-400 char. VarChar(500) supaya bisa
  // di-index @unique (MySQL tidak boleh unique index di TEXT tanpa prefix).
  endpoint   String   @unique @db.VarChar(500)
  p256dh     String   @db.VarChar(255)
  auth       String   @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// OTP satu-per-email. Register / resend timpa row lama. Verifikasi sukses hapus row.
model EmailVerification {
  id         String   @id @default(uuid())
  email      String   @unique
  otp        String   // 6-digit, disimpan hashed via scrypt
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

// Token satu-shot untuk reset password. Disimpan hashed. Setelah dipakai, usedAt di-set.
model PasswordReset {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Rumah") // "Rumah" | "Kantor" | "Kos" | "Lainnya"
  recipientName String
  phone         String
  streetAddress String
  rtRw          String
  province      String
  city          String
  district      String
  village       String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  category    String
  gender      String
  form        String
  coloration  String
  description String  @db.Text
  image       String
  isSold      Boolean  @default(false)
  isPremium   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  statsForm   String   @default("COMP")
  age         String   @default("4 Month")
  statsSpirit String   @default("Aktif")
  quantity    Int      @default(1)
  sizes       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Money breakdown: subtotal = sum of item prices, shippingFee = courier cost,
  // total = subtotal + shippingFee. All authoritative from the server.
  subtotal        Float   @default(0)
  shippingFee     Float   @default(0)
  total           Float
  // Courier snapshot (immutable per order — Biteship code + service tier)
  shippingCourier String? // e.g. "jne", "jnt", "sicepat", "gosend"
  shippingService String? // e.g. "REG", "YES", "SAME_DAY"
  shippingEta     String? // e.g. "1-2 hari"
  trackingNumber  String? // e.g. "JB000111222333" (AWB from courier)
  biteshipShipmentId String? // e.g. "62f4b..." (Biteship internal ID)
  biteshipStatus  String? // e.g. "allocated", "picking_up", "picked", "dropped", "delivered"
  status    String      @default("PENDING") // "PENDING" | "PROCESSING" | "SHIPPED" | "COMPLETED" | "CANCELLED" | "RETURNED"
  name      String
  email     String
  phone         String
  streetAddress String
  rtRw          String
  province      String
  city          String
  district      String
  village       String
  postalCode    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float
  selectedSize String?
}

model PromoEvent {
  id          String    @id @default(uuid())
  title       String
  subtitle    String?
  description String    @db.Text
  image       String    @default("/betta-2.png")
  targetUrl   String
  buttonText  String    @default("Lihat Event")
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

